# Cutline environment — variable NAMES only. Never commit real values.
# Local development: `npm run dev` creates the two secrets below in .env.local automatically
# and uses an embedded PostgreSQL, so nothing here is required to start.

# ── Core (required in production) ─────────────────────────────────────
DATABASE_URL=
APP_URL=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CUTLINE_ENCRYPTION_KEY=
# At least 32 characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CUTLINE_SIGNING_SECRET=
# Docker Compose only
POSTGRES_PASSWORD=

# ── YouTube (OAuth web client; redirect URI = APP_URL/api/oauth/google/callback) ──
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: public-channel research without OAuth
YOUTUBE_API_KEY=

# ── Installation-wide AI providers (optional; workspaces can store their own keys) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# ── Storage (default: local disk) ─────────────────────────────────────
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.media
SCRATCH_DIR=.scratch
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=

# ── Media processing / worker ─────────────────────────────────────────
FFMPEG_PATH=
FFPROBE_PATH=
WORKER_CONCURRENCY=2

# ── Tests only. NEVER enable in production (refused when NODE_ENV=production). ──
CUTLINE_ENABLE_MOCK_PROVIDERS=
